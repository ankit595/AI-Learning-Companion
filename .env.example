# =============================================================================
# .env.example — copy this file to .env and fill in your own values.
# Never commit your real .env file (it should already be in .gitignore).
#
# QUICK START OPTIONS:
#
#   Option A — Groq only (free tier, no OpenAI key needed):
#     LLM_PROVIDER=groq
#     GROQ_API_KEY=gsk_...
#     DOCKER_LLM_PROVIDER=groq
#     → Embeddings will use local HuggingFace (BAAI/bge-small-en-v1.5)
#       First run downloads ~130MB model — cached after that.
#
#   Option B — OpenAI (best quality):
#     LLM_PROVIDER=openai
#     OPENAI_API_KEY=sk-...
#     DOCKER_LLM_PROVIDER=openai
#
#   Option C — Groq LLM + OpenAI embeddings (recommended if you have both):
#     LLM_PROVIDER=groq
#     GROQ_API_KEY=gsk_...
#     OPENAI_API_KEY=sk-...   ← used for embeddings only
#     DOCKER_LLM_PROVIDER=groq
# =============================================================================

# -----------------------------------------------------------------------------
# ★ Local provider (used when running without Docker)
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# ★ Docker provider (used inside containers — set independently of LLM_PROVIDER)
# -----------------------------------------------------------------------------
DOCKER_LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Groq (fast inference, free tier — get key at console.groq.com)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
# GROQ_LLM_MODEL=llama-3.1-8b-instant    # fast + cheap (default)
# GROQ_LLM_MODEL=llama-3.3-70b-versatile # better quality, slower

# -----------------------------------------------------------------------------
# OpenAI (optional — only needed if LLM_PROVIDER=openai, or for embeddings
# when using Groq without wanting local HuggingFace embeddings)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Google Gemini
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY=
# GEMINI_LLM_MODEL=gemini-2.0-flash
# GEMINI_EMBED_MODEL=models/embedding-001

# -----------------------------------------------------------------------------
# Ollama (fully local, no API key needed — requires Ollama running locally)
# -----------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# NetApp internal proxy (corporate/internal use only — not needed for OSS use)
# -----------------------------------------------------------------------------
# NETAPP_BASE_URL=
# NETAPP_USER=
# NETAPP_CA_BUNDLE=   # only if the default cert paths in config.py don't apply

# -----------------------------------------------------------------------------
# Neo4j (Phase 5 — knowledge graph, not required yet)
# -----------------------------------------------------------------------------
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your_password
